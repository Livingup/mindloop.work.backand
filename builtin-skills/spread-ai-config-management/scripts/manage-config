#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
CORE_SCRIPT="$SCRIPT_DIR/manage-config.mjs"

if [ ! -f "$CORE_SCRIPT" ]; then
  printf '%s\n' '{"error":"Core script not found."}' >&2
  exit 1
fi

if [ -n "${SPREAD_AI_CONFIG_MANAGEMENT_NODE:-}" ]; then
  exec "$SPREAD_AI_CONFIG_MANAGEMENT_NODE" "$CORE_SCRIPT" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$CORE_SCRIPT" "$@"
fi

printf '%s\n' '{"error":"Node.js is required to run this cross-platform management Skill script. Install Node or set SPREAD_AI_CONFIG_MANAGEMENT_NODE."}' >&2
exit 1
