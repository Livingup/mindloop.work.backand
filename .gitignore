# =============================================
# 环境变量 / 敏感凭证（禁止提交）
# =============================================
.env
.env.*
!.env.example
!config/.env.dev

# =============================================
# Python 构建与运行产物
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/
*.whl
*.tar.gz
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# 虚拟环境
.venv/
venv/
ENV/

# 类型检查 / 代码分析缓存
.mypy_cache/
.pytype/
.ruff_cache/
.pyre/

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# =============================================
# IDE / 编辑器
# =============================================
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# =============================================
# 操作系统临时文件
# =============================================
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# =============================================
# 项目专属排除
# =============================================
# 工作流代理运行时目录
/.workflowagent/
/.spread-ai/

# 项目文档（外部API参考等大文件，不纳入版本管理）
/doc/

# 运行时数据（由程序动态生成，不纳入版本管理）
/runtime-data/

# 测试代码（历史上默认忽略新测试文件；需要长期回归保障的测试需显式放行纳入版本管理）
/tests/*
!/tests/test_scene_session_registry.py
!/tests/test_runtime_auth_token_transport.py
!/tests/test_system_settings_persistence_inventory.py
!/tests/test_cloud_user_config_migration.py
!/tests/test_cloud_user_config_config_center.py
!/tests/test_logs_management_service.py
!/tests/test_tool_schema_sanitizer.py
!/tests/test_execution_loop_logger.py
!/tests/test_subagent_conversation_history.py
!/tests/test_sqlite_threaded_repositories.py
!/tests/test_lacp_inbound_attachments.py
!/tests/test_release_windows_subprocess_visibility.py
!/tests/test_workspace_tree_lazy_loading.py
!/tests/test_context_compression_worker_contents.py
!/tests/test_mcp_metadata_cache.py

/web-frontend/

# =============================================
# 日志与临时文件
# =============================================
*.log
*.tmp
*.bak
*.orig